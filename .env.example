PORT=4000
AGENT_API_KEY=replace-with-a-long-random-value
OPERATOR_API_KEY=replace-with-a-second-long-random-value
DATA_DIR=./data
MODAL_APP_NAME=agent-compute-gateway

# Preferred CI path: Infisical Cloud OIDC injects MODAL_TOKEN_ID and
# MODAL_TOKEN_SECRET at runtime. No long-lived Infisical client secret is
# required in GitHub Actions.

# Local/dev fallback only: Infisical Universal Auth.
INFISICAL_SITE_URL=https://app.infisical.com
INFISICAL_CLIENT_ID=
INFISICAL_CLIENT_SECRET=
INFISICAL_PROJECT_ID=
INFISICAL_ENVIRONMENT=dev
INFISICAL_SECRET_PATH=/providers/modal
INFISICAL_HF_SECRET_PATH=/providers/huggingface

# Hugging Face provider (Gate 2). Namespace is the HF user/org that owns the
# Jobs quota. The HF_TOKEN itself lives in Infisical or is injected by a
# trusted secret runtime, never in this file.
HF_ENDPOINT=https://huggingface.co
HF_NAMESPACE=

# Gate 3 deterministic route order. Unconfigured providers are skipped.
ROUTE_ORDER=huggingface,modal

# Runtime policy. Empty ALLOWED_GPUS / ALLOWED_PROVIDERS means no restriction.
MAX_TIMEOUT_MS=300000
MAX_OUTPUT_BYTES=262144
ALLOWED_GPUS=
ALLOWED_PROVIDERS=
